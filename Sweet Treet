def wait_for_elements(driver, timeout=30):
    WebDriverWait(driver, timeout).until(
        EC.presence_of_all_elements_located((By.CLASS_NAME, 'x-stream-photo-grid-item-view'))
    )

def get_gps_from_exif(image_path):
    try:
        with Image.open(image_path) as img:
            exif_data = img._getexif()
    except Exception as e:
        print(f"Error opening image: {e}")
        return None

    if not exif_data:
        return None

    gps_info = {}
    date_taken = None

    for tag, value in exif_data.items():
        decoded = TAGS.get(tag, tag)
        if decoded == "GPSInfo":
            for gps_tag, gps_value in value.items():
                decoded_gps = GPSTAGS.get(gps_tag, gps_tag)
                gps_info[decoded_gps] = gps_value
        elif decoded == "DateTimeOriginal":
            date_taken = value

    if not gps_info:
        return None

    def to_float(val):
        if isinstance(val, tuple) and len(val) == 2:
            return float(val[0]) / float(val[1])
        if hasattr(val, 'numerator') and hasattr(val, 'denominator'):
            return float(val.numerator) / float(val.denominator)
        return float(val)

    def convert_to_decimal(dms, ref):
        degrees = to_float(dms[0])
        minutes = to_float(dms[1])
        seconds = to_float(dms[2])
        decimal = degrees + minutes / 60 + seconds / 3600
        if ref in ("S", "W"):
            decimal *= -1
        return decimal

    try:
        lat = convert_to_decimal(gps_info["GPSLatitude"], gps_info["GPSLatitudeRef"])
        lon = convert_to_decimal(gps_info["GPSLongitude"], gps_info["GPSLongitudeRef"])
        return {"latitude": lat, "longitude": lon, "date": date_taken}
    except Exception as e:
        return None

def auto_orient_image(img):
    try:
        for orientation in ExifTags.TAGS.keys():
            if ExifTags.TAGS[orientation] == 'Orientation':
                break
        exif = img._getexif()
        if not exif:
            return img
        exif = dict(exif.items())
        if exif.get(orientation) == 3:
            img = img.rotate(180, expand=True)
        elif exif.get(orientation) == 6:
            img = img.rotate(270, expand=True)
        elif exif.get(orientation) == 8:
            img = img.rotate(90, expand=True)
    except Exception:
        pass
    return img

def create_popup_html(resized_filepath, lat, lon, date_taken=None):
    # Embed image as base64 so it works anywhere, no file path dependency
    with open(resized_filepath, "rb") as f:
        img_b64 = base64.b64encode(f.read()).decode("utf-8")

    ext = os.path.splitext(resized_filepath)[1].lower().strip(".")
    mime = "jpeg" if ext in ("jpg", "jpeg") else ext
    img_src = f"data:image/{mime};base64,{img_b64}"

    date_html  = f"<p>📅 {date_taken}</p>" if date_taken else ""
    gmaps_link = f"https://www.google.com/maps?q={lat},{lon}"

    html = f"""
    <div style="width:300px;">
        <img src="{img_src}" style="width:100%;">
        {date_html}
        <p><a href="{gmaps_link}" target="_blank">Take me to the tree 🌲</a></p>
    </div>
    """
    return folium.Popup(folium.IFrame(html, width=320, height=420))


