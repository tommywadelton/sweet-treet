options = Options()
options.add_argument('--headless')
options.add_argument('--disable-gpu')
options.add_argument('--no-sandbox')
options.add_argument('--window-size=1920,1080')
service = Service(ChromeDriverManager().install())
driver = webdriver.Chrome(service=service, options=options)

try:
    driver.get(Shared_Album_images)
    time.sleep(5)
    image_urls = set()
    scroll_count = 0
    previous_count = 0
    retry_attempts = 0

    print("🌐 Gathering Photos from iCloud...")
    while scroll_count < MAX_SCROLLS:
        body = driver.find_element(By.TAG_NAME, "body")
        body.send_keys(Keys.PAGE_DOWN)
        time.sleep(SCROLL_PAUSE)
        scroll_count += 1
        wait_for_elements(driver)

        imgs = driver.find_elements(By.TAG_NAME, "img")
        for img in imgs:
            src = img.get_attribute("src")
            if src and "icloud-content.com" in src:
                image_urls.add(src)

        divs = driver.find_elements(By.CLASS_NAME, "x-stream-photo-grid-item-view")
        for div in divs:
            style = div.get_attribute("style")
            if style and "url(" in style:
                start = style.find("url(") + 4
                end = style.find(")", start)
                url = style[start:end].strip('"').strip("'")
                if "icloud-content.com" in url:
                    image_urls.add(url)

        current_count = len(image_urls)
        if current_count == previous_count:
            retry_attempts += 1
            if retry_attempts >= MAX_RETRIES:
                break
        else:
            retry_attempts = 0
        previous_count = current_count

    print(f"✅ Total images gathered: {len(image_urls)}")

    # Save images
    for idx, url in enumerate(image_urls):
        try:
            parsed = urlparse(url)
            ext = os.path.splitext(parsed.path)[1] or '.jpg'
            filename = f"img_{idx}{ext}"
            filepath = os.path.join(image_folder, filename)
            if os.path.exists(filepath):
                continue
            response = requests.get(url, timeout=15)
            if response.status_code == 200:
                with open(filepath, "wb") as f:
                    f.write(response.content)
            else:
                print(f"Failed to download {filename}: status {response.status_code}")
        except Exception as e:
            print(f"Error downloading image {idx}: {e}")
finally:
    driver.quit()
    print("✅ Selenium driver closed")


